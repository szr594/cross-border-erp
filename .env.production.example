HTTP_PORT=80
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_SECRET=
# false for LAN HTTP; true when HTTPS is configured
SECURE_COOKIE=false
# Required only when compose.identity.yml is enabled
IDENTITY_DATABASE_PASSWORD=
IDENTITY_MYSQL_ROOT_PASSWORD=
IDENTITY_KEY_ID=
IDENTITY_KEYS_DIR=
# Required only when compose.order.yml is enabled (shadow deployment)
ORDER_DATABASE_PASSWORD=
ORDER_MYSQL_ROOT_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Required only for an explicitly enabled order bridge; not enabled by the shadow Compose
ORDER_INTERNAL_SERVICE_TOKEN=
ORDER_SERVICE_INTERNAL_URL=http://order:8082
LEGACY_BACKEND_INTERNAL_URL=http://backend:8090
